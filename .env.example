# =========================================================================
# Project Bondhu - Environment Variables Template
# Copy this file to '.env' and fill with your actual credentials.
# =========================================================================

# Wi-Fi Credentials
WIFI_SSID="Your_WiFi_SSID"
WIFI_PASSWORD="Your_WiFi_Password"

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# Google Cloud Text-To-Speech API Key
GOOGLE_TTS_API_KEY="AIzaSy..."

# OpenWeatherMap API Key (Optional for live weather display)
OPENWEATHER_API_KEY="your_openweather_api_key"

# User & Persona Customization
DEFAULT_USER_NAME="Fahim"
MASCOT_NAME="Kiko"
WEATHER_CITY="Dhaka"
